{
  "name": "provoware-html-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Modularer JSON-Store mit Self-Repair und Hilfe-Panel",
  "scripts": {
    "format": "npx prettier --write \"{system-core,system-module,tools,test,templates,config,data,docs}/**/*.{js,json,md,html}\" \"CHANGELOG.md\" \"SELFINFO.md\" \"PROJECT_INFO.md\" \"MEMORY_FIXES.md\" \"QUESTIONS_TODO.md\"",
    "format:check": "npx prettier --check \"{system-core,system-module,tools,test,templates,config,data,docs}/**/*.{js,json,md,html}\" \"CHANGELOG.md\" \"SELFINFO.md\" \"PROJECT_INFO.md\" \"MEMORY_FIXES.md\" \"QUESTIONS_TODO.md\"",
    "test": "node --test",
    "system:test": "node tools/help_cli.js test",
    "release:check": "node tools/release_readiness_check.js"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
