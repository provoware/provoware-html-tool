{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TodoKalenderErinnerungStore",
  "type": "object",
  "required": ["version", "tasks"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "area", "priority", "status", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 3, "maxLength": 80 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "detail": { "type": "string", "maxLength": 800 },
          "area": { "type": "string", "minLength": 1, "maxLength": 60 },
          "priority": { "type": "string", "enum": ["niedrig", "mittel", "hoch"] },
          "status": { "type": "string", "enum": ["offen", "erledigt"] },
          "dueDate": {
            "anyOf": [
              { "type": "string", "format": "date" },
              { "type": "null" }
            ]
          },
          "reminderAt": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "doneAt": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
