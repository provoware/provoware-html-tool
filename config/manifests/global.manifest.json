{
  "manifestType": "global-standards",
  "version": "1.0.0",
  "maxCoreUpdatePolicy": "Nur bei Sicherheits- oder Stabilitätsgrund",
  "requiredChecks": [
    "input-validierung",
    "output-validierung",
    "fehlermeldung-mit-naechstem-schritt",
    "automatischer-test",
    "automatisches-format"
  ],
  "a11y": {
    "themes": ["hell", "dunkel", "kontrast-plus"],
    "focusVisible": true,
    "statusNeedsText": true
  }
}
