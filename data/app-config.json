{
  "appName": "ProvoWare Dashboard",
  "version": "0.1.0",
  "defaultTheme": "design-nachtblau",
  "minimumSizes": {
    "wide": {
      "minWidth": 1400,
      "minHeight": 820
    },
    "standard": {
      "minWidth": 1100,
      "minHeight": 760
    },
    "kompakt": {
      "minWidth": 900,
      "minHeight": 680
    },
    "eng": {
      "minWidth": 0,
      "minHeight": 620
    }
  },
  "layoutModes": [
    "wide",
    "standard",
    "kompakt",
    "eng"
  ],
  "startBehavior": {
    "requireStartupCheck": true,
    "selftestAsFirstStep": true,
    "blockModulesUntilReady": true,
    "teamDefaultEntry": "start.sh"
  }
}
